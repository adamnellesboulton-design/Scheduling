{
  "name": "Pediatric Dialysis Unit Scheduler",

  // Use the official Python image from Docker Hub. The previous base
  // (mcr.microsoft.com/devcontainers/python) depends on Microsoft's container
  // registry, which intermittently returns 401 "credentials may be expired" and
  // fails the Codespace build (it failed even for the alpine recovery image).
  // Docker Hub removes that dependency.
  "image": "python:3.11-slim-bookworm",

  // git isn't in the slim image; install it, then the Python dependencies.
  // Runs once, when the Codespace is first created.
  "postCreateCommand": "apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* && pip install --upgrade pip && pip install -r requirements.txt",

  // Start the Streamlit app automatically every time you open the Codespace.
  "postAttachCommand": {
    "app": "streamlit run app.py --server.port 8501 --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"
  },

  // Expose the Streamlit port and pop the app open in a preview tab.
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Dialysis Scheduler (Streamlit)",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
